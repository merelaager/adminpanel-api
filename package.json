{
  "name": "ml-new-backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "gen:email": "node scripts/gen-email-layout.mjs",
    "build": "tsc && tsc-alias",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "seed": "tsx prisma/seed.ts",
    "lint": "eslint .",
    "test": "NODE_ENV=test node --import tsx --test --test-concurrency=1 --test-force-exit \"test/**/*.test.ts\"",
    "test:db:up": "docker compose -f compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f compose.test.yml down -v",
    "test:db:push": "DATABASE_URL=mysql://ml_test:ml_test@127.0.0.1:3307/ml_test prisma db push",
    "test:full": "yarn test:db:up && yarn test:db:push && yarn gen:email && yarn test",
    "typecheck": "tsc -p test/tsconfig.json && tsc -p prisma/tsconfig.json"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/env": "^7.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/session": "^11.1.3",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@quixo3/prisma-session-store": "^3.1.21",
    "@sinclair/typebox": "^0.34.52",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.4",
    "express-session": "^1.19.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "http-status-codes": "^2.3.0",
    "nodemailer": "^9.1.1",
    "nodemailer-mailgun-transport": "^2.1.5",
    "pdfkit": "^0.20.2",
    "pdfmake": "^0.3.11",
    "typebox": "^1.3.34",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/mjml": "^5.0.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/nodemailer-mailgun-transport": "^1.4.6",
    "@types/pdfkit": "^0.17.6",
    "@types/pdfmake": "^0.3.3",
    "eslint": "^10.11.0",
    "mjml": "^5.4.1",
    "prettier": "3.9.9",
    "prisma": "^7.10.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "resolutions": {
    "mariadb": "3.4.7"
  },
  "private": true,
  "packageManager": "yarn@4.16.0"
}
